{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBonsukeSiteBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::bonsuke-site-prod"
    },
    {
      "Sid": "WriteBonsukeSiteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::bonsuke-site-prod/*"
    },
    {
      "Sid": "InvalidateBonsukeCloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::169805602203:distribution/ERA76BJB7WLEN"
    }
  ]
}
