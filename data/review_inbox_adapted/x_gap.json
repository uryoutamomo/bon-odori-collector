        "source_officiality": {
          "classification": "registered_official_social",
          "score": 100,
          "handle": "@mitibata1",
          "account_name": "道端俊彦 （みちばたとしひこ）【大阪府議会議員】地域の声、一人ひとりの声を府政へ届ける！「是々非々」",
