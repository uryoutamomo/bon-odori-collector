<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ryotauchida.bon-odori.glossary-weekly</string>

  <key>WorkingDirectory</key>
  <string>/Users/ryotauchida/bon-odori-collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/ryotauchida/bon-odori-collector/run_weekly_glossary_review.py</string>
    <string>--days</string>
    <string>7</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>4</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/ryotauchida/bon-odori-collector/logs/glossary-weekly.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/ryotauchida/bon-odori-collector/logs/glossary-weekly.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
